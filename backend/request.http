    "email": "manu10@gmail.com",
    "password": "123456"
}

### USER LOGIN
POST http://localhost:3001/api/auth/login
Content-Type: application/json

{
    "email": "manu10@gmail.com",
    "password": "123456"
}

### USER LOGOUT
POST http://localhost:3001/api/auth/logout

